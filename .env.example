# Clave de API de Google Gemini (Obtén una en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo preferido (gemini-2.5-flash con fallback automático a gemini-3.5-flash / gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# URL base de la API de gestión de turnos a auditar
# Si apuntas a localhost y no hay servidor levantado, el agente iniciará su Mock Server automáticamente.
API_BASE_URL=http://localhost:3001/api

# Límite de seguridad de iteraciones para el bucle autónomo (entre 35 y 50)
MAX_ITERATIONS=40

# Timeout para llamadas HTTP en milisegundos
API_TIMEOUT_MS=8000

# Ruta de salida del reporte técnico en formato Markdown
REPORT_FILE_PATH=./reporte_pruebas_turnos.md
